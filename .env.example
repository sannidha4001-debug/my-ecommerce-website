# ============================================================
# GameXchange environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local and NEVER expose the service role key.
# ============================================================

# Public Supabase URL - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key - safe to expose, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key - bypasses RLS. Used ONLY in server code.
# NEVER add NEXT_PUBLIC_ to this name.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for auth redirects and metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: TOTP issuer shown in authenticator apps.
NEXT_PUBLIC_TOTP_ISSUER=GameXchange
